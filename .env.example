# Скопируйте в .env в корне проекта при необходимости изменить параметры.
HOST=0.0.0.0
PORT=8000
MAX_PENDING_TASKS=2
# TASK_DB_PATH=C:/путь/к/папке/tasks.sqlite3
# FFMPEG_BINARY=C:/путь/к/ffmpeg.exe
USE_GPU=false
OCR_BATCH_SIZE=6
TROCR_QUANTIZE_DECODER=true
TROCR_USE_KV_CACHE=true
TROCR_NUM_BEAMS=2
TTS_ENGINE=silero
SILERO_SPEAKER=xenia
SILERO_SAMPLE_RATE=48000
USE_FALLBACK_TTS=false
ALLOW_ONLINE_TTS=false
MAX_IMAGE_BYTES=15728640
MAX_IMAGE_PIXELS=20000000
MAX_IMAGE_SIDE=6000
# LOG_DIR=C:/путь/к/папке/логов
